# ==============================================================
# AuditFlow — environment variables (.env.example)
# Copy to .env.local for development. NEVER commit real values.
# ==============================================================

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/auditflow?sslmode=require"
# Optional direct (non-pooled) URL for migrations
DATABASE_URL_UNPOOLED=""

# --- Auth ---
AUTH_SECRET="0mX4Lr8OQMB+dGRvIYfWMOajXIPua39RhtqaVLkJJGI="                      # openssl rand -base64 32
AUTH_TRUST_HOST="true"

# --- Master Admin seed (used ONLY by scripts/seed.ts; remove after seeding) ---
MASTER_ADMIN_EMAIL="malikrehan@tabontech.com"
MASTER_ADMIN_INITIAL_PASSWORD=""    # set locally, e.g. "pakistan@123"; hashed on seed; never logged

# --- Settings encryption (admin-entered API keys encrypted at rest) ---
SETTINGS_ENCRYPTION_KEY=""          # 32-byte hex: openssl rand -hex 32

# --- Google PageSpeed Insights ---
PAGESPEED_API_KEY=""

# --- Background jobs (Upstash QStash) ---
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Rate limiting / cache (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Headless browser (production: remote CDP endpoint, e.g. Browserless) ---
BROWSER_WS_ENDPOINT=""              # empty in dev → falls back to local Playwright

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="AuditFlow <noreply@yourdomain.com>"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_YEARLY=""

# --- File/screenshot storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""
