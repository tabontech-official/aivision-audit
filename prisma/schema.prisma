  @@map("stripe_webhook_events")
}

// ----------------------------------------------------------------
// LEADS — the primary business goal
// ----------------------------------------------------------------

// Captured on the landing form BEFORE the audit runs: a visitor who audits,
// reads the teaser and leaves still gave us a URL and an email. One row per
// email+domain pair; repeat audits update rather than duplicate.
model Lead {
  id         String @id @default(uuid()) @db.Uuid
  email      String
  websiteUrl String @map("website_url") // normalized
  domain     String // for grouping and dedupe

  // GDPR/UK-PECR: consent defaults unticked, stored with proof. The IP is
  // hashed — proof of consent without retaining the address itself.
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  consentAt        DateTime? @map("consent_at") @db.Timestamptz
  consentIpHash    String?   @map("consent_ip_hash") // sha256(ip)
  source           String? // landing | pricing | blog | partner

  // Shopify pivot: which platforms show up is market data.
  platform       String? // SHOPIFY | HYDROGEN | WORDPRESS | … | UNKNOWN
  themeName      String? @map("theme_name")
  appCount       Int?    @map("app_count")
  plusLikelihood String? @map("plus_likelihood") // unknown | possible

  anonymousSessionId String?   @map("anonymous_session_id") @db.Uuid
  firstReportId      String?   @map("first_report_id") @db.Uuid
  convertedUserId    String?   @map("converted_user_id") @db.Uuid
  convertedAt        DateTime? @map("converted_at") @db.Timestamptz

  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([email, domain])
  @@index([email])
  @@index([domain])
  @@index([convertedUserId])
  @@index([platform])
  @@map("leads")
}

// ----------------------------------------------------------------
// THE FIX LOOP (Phase 2)
// ----------------------------------------------------------------

model Finding {
  id        String  @id @default(uuid()) @db.Uuid
  websiteId String  @map("website_id") @db.Uuid
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  identityHash String @map("identity_hash") // sha256(fieldKey + ':' + normalizedPageUrl)
  fieldKey     String @map("field_key")
  pageUrl      String @map("page_url")

  // Denormalized for display and filtering — REFRESHED on every reconciliation.
  sectionSlug String   @map("section_slug")
  sectionName String   @map("section_name")
  checkName   String   @map("check_name")
  severity    Severity
  pillar      ReportPillar @default(FOUNDATIONS)

  state    FindingState @default(OPEN)
  userNote String?      @map("user_note") @db.Text

  firstSeenAt  DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz // set entering VERIFIED_FIXED, cleared on exit
  staleSince   DateTime? @map("stale_since") @db.Timestamptz // audit produced no result for this identity
  lastReportId String?   @map("last_report_id") @db.Uuid

  events FindingEvent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([websiteId, identityHash])
  @@index([websiteId, state])
  @@index([websiteId, severity])
  @@index([websiteId, staleSince])
  @@map("findings")
}

model FindingEvent {
  id        String  @id @default(uuid()) @db.Uuid
  findingId String  @map("finding_id") @db.Uuid
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  // Deleting a report must never destroy finding history — SetNull, not Cascade.
  reportId String? @map("report_id") @db.Uuid
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  checkStatus CheckStatus?  @map("check_status") // what the engine observed this run
  stateBefore FindingState? @map("state_before") // null = this event created the finding
  stateAfter  FindingState  @map("state_after")
  actor       FindingActor
  userId      String?       @map("user_id") @db.Uuid
  note        String?       @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([findingId, createdAt])
  @@index([reportId])
  @@map("finding_events")
}

// Lightweight funnel counters (Part D) — append-only, so the progressive
// lead-capture decision can be evaluated rather than argued about. The number
// that matters: emails captured per 100 audits started.
model FunnelEvent {
  id        String   @id @default(uuid()) @db.Uuid
  event     String // audit_started | email_captured_progress | email_captured_signup | audit_completed | teaser_viewed | signup_completed
  reportId  String?  @map("report_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([event, createdAt])
  @@map("funnel_events")
}

// ----------------------------------------------------------------
// SYSTEM
// ----------------------------------------------------------------

// Key-value settings. Typed access layer validates each key with Zod.
// `isSecret` values are AES-256-GCM encrypted (SETTINGS_ENCRYPTION_KEY) via
// src/lib/security/secrets.ts, masked in all API responses. Migrate legacy
// plaintext rows with scripts/encrypt-secret-settings.ts.
// Seeded keys: product_name, support_email, free_audit_limit,
// premium_audit_limit, anonymous_report_expiration_days, score_ranges,
// pagespeed_api_key (secret), maintenance_mode, terms_url, privacy_url,
// cookie_policy_url, anonymous_audits_per_hour_ip
model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json?
  isSecret    Boolean  @default(false) @map("is_secret")
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model BrandingSetting {
  id           String   @id @default(uuid()) @db.Uuid
  productName  String   @default("AuditFlow") @map("product_name")
  logoUrl      String?  @map("logo_url")
  logoDarkUrl  String?  @map("logo_dark_url")
  faviconUrl   String?  @map("favicon_url")
  primaryColor String   @default("#4F46E5") @map("primary_color") // indigo-600
  accentColor  String   @default("#7C3AED") @map("accent_color") // premium purple
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy User? @relation("BrandingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("branding_settings")
}

// Editable transactional email templates. Variables use the same {{placeholder}}
// whitelist convention as suggestions ({{name}}, {{verifyUrl}}, {{resetUrl}}, …).
model EmailTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  key                String   @unique // verify_email | reset_password | report_ready | welcome | payment_failed
  name               String
  subject            String
  htmlBody           String   @map("html_body")
  textBody           String?  @map("text_body")
  availableVariables Json     @default("[]") @map("available_variables") // string[]
  isEnabled          Boolean  @default(true) @map("is_enabled")
  updatedById        String?  @map("updated_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy User? @relation("EmailTplUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("email_templates")
}

// Every admin mutation: who, what, before/after
model AdminActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. "section.update", "user.plan_change"
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("LogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

// External API consumption tracking (PSI, Browserless, Resend, Stripe)
model ApiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  provider     String // pagespeed | browserless | resend | stripe
  endpoint     String?
  userId       String?  @map("user_id") @db.Uuid
  reportId     String?  @map("report_id") @db.Uuid
  statusCode   Int?     @map("status_code")
  durationMs   Int?     @map("duration_ms")
  success      Boolean  @default(true)
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([userId])
  @@map("api_usage")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?          @map("link_url")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

// Complete App Execution Logs — capturing pipeline stages, stuck audits, errors & stack traces
model SystemExecutionLog {
  id           String   @id @default(uuid()) @db.Uuid
  level        LogLevel @default(INFO)
  category     String   // e.g. "AUDIT_PIPELINE", "FETCH_HTML", "PLAYWRIGHT_RENDER", "PAGESPEED_API", "SYSTEM_ERROR"
  message      String
  reportId     String?  @map("report_id") @db.Uuid
  websiteUrl   String?  @map("website_url")
  stage        String?  // AuditStage string representation
  durationMs   Int?     @map("duration_ms")
  meta         Json?    // Context payload, HTTP headers, request params
  stackTrace   String?  @map("stack_trace")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([level])
  @@index([category])
  @@index([reportId])
  @@index([createdAt])
  @@map("system_execution_logs")
}

// ----------------------------------------------------------------
// BACKLINKS MODULE (Mangools Integration)
// ----------------------------------------------------------------

enum AnchorType {
  BRANDED
  EXACT_MATCH
  PARTIAL_MATCH
  NAKED_URL
  GENERIC
  OTHER
}

model BacklinkAudit {
  id                  String   @id @default(uuid()) @db.Uuid
  websiteId           String   @map("website_id") @db.Uuid
  domain              String
  totalBacklinks      Int      @default(0) @map("total_backlinks")
  referringDomains    Int      @default(0) @map("referring_domains")
  referringPages      Int      @default(0) @map("referring_pages")
  dofollowBacklinks   Int?     @map("dofollow_backlinks")
  nofollowBacklinks   Int?     @map("nofollow_backlinks")
  newBacklinks        Int?     @map("new_backlinks")
  lostBacklinks       Int?     @map("lost_backlinks")
  referringIps        Int?     @map("referring_ips")
  referringSubnets    Int?     @map("referring_subnets")
  domainRank          Int?     @map("domain_rank")
  brokenBacklinks     Int      @default(0) @map("broken_backlinks")
  suspiciousBacklinks Int      @default(0) @map("suspicious_backlinks")
  healthStatus        String   @default("Good") @map("health_status") // Good | Needs Attention | Critical
  status              String   @default("completed") @map("status") // pending | fetching | completed | partially_completed | failed
  fetchedRowsCount    Int      @default(0) @map("fetched_rows_count")
  lastFetchedPage     Int      @default(0) @map("last_fetched_page")
  progressMessage     String?  @map("progress_message")
  metricsJson         Json?    @map("metrics_json")
  fetchedAt           DateTime @default(now()) @map("fetched_at") @db.Timestamptz
  expiresAt           DateTime @map("expires_at") @db.Timestamptz
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  website              Website                  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  backlinks            BacklinkRecord[]
  referringDomainsList ReferringDomainItem[]
  anchors              AnchorRecord[]
  topPages             TopPageRecord[]
  recommendations      BacklinkRecommendation[]

  @@index([websiteId])
  @@index([domain])
  @@index([fetchedAt])
  @@map("backlink_audits")
}

model BacklinkRecord {
  id              String    @id @default(uuid()) @db.Uuid
  auditId         String    @map("audit_id") @db.Uuid
  referringDomain String    @map("referring_domain")
  referringUrl    String    @map("referring_url")
  targetUrl       String    @map("target_url")
  anchor          String?
  isDofollow      Boolean   @default(true) @map("is_dofollow")
  domainRank      Int       @default(0) @map("domain_rank")
  pageRank        Int       @default(0) @map("page_rank")
  httpStatus      Int?      @map("http_status")
  isNew           Boolean   @default(false) @map("is_new")
  isLost          Boolean   @default(false) @map("is_lost")
  isBroken        Boolean   @default(false) @map("is_broken")
  isSuspicious    Boolean   @default(false) @map("is_suspicious")
  lossReason      String?   @map("loss_reason")
  firstSeen       DateTime? @map("first_seen") @db.Timestamptz
  lastSeen        DateTime? @map("last_seen") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  audit BacklinkAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([referringDomain])
  @@index([isDofollow])
  @@index([isNew])
  @@index([isLost])
  @@index([isBroken])
  @@index([isSuspicious])
  @@map("backlink_records")
}

model ReferringDomainItem {
  id             String    @id @default(uuid()) @db.Uuid
  auditId        String    @map("audit_id") @db.Uuid
  domain         String
  backlinksCount Int       @default(0) @map("backlinks_count")
  dofollowCount  Int       @default(0) @map("dofollow_count")
  nofollowCount  Int       @default(0) @map("nofollow_count")
  domainRank     Int       @default(0) @map("domain_rank")
  ip             String?
  country        String?
  firstSeen      DateTime? @map("first_seen") @db.Timestamptz
  lastSeen       DateTime? @map("last_seen") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  audit BacklinkAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([domain])
  @@index([domainRank])
  @@map("referring_domain_items")
}

model AnchorRecord {
  id                    String     @id @default(uuid()) @db.Uuid
  auditId               String     @map("audit_id") @db.Uuid
  anchor                String
  backlinksCount        Int        @default(0) @map("backlinks_count")
  referringDomainsCount Int        @default(0) @map("referring_domains_count")
  percentage            Float      @default(0)
  classification        AnchorType @default(OTHER)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz

  audit BacklinkAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([classification])
  @@map("anchor_records")
}

model TopPageRecord {
  id                    String   @id @default(uuid()) @db.Uuid
  auditId               String   @map("audit_id") @db.Uuid
  targetUrl             String   @map("target_url")
  backlinksCount        Int      @default(0) @map("backlinks_count")
  referringDomainsCount Int      @default(0) @map("referring_domains_count")
  dofollowCount         Int      @default(0) @map("dofollow_count")
  nofollowCount         Int      @default(0) @map("nofollow_count")
  brokenCount           Int      @default(0) @map("broken_count")
  httpStatus            Int?     @map("http_status")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  audit BacklinkAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([targetUrl])
  @@map("top_page_records")
}

model BacklinkRecommendation {
  id               String   @id @default(uuid()) @db.Uuid
  auditId          String   @map("audit_id") @db.Uuid
  ruleKey          String   @map("rule_key")
  title            String
  severity         String   // Critical | High | Medium | Low | Opportunity | Good
  priorityScore    Int      @default(50) @map("priority_score") // 0-100
  confidence       String   @default("Medium") // High | Medium | Low
  status           String   @default("active") // active | resolved | dismissed
  whatWeFound      String   @map("what_we_found") @db.Text
  whyItMatters     String   @map("why_it_matters") @db.Text
  howToImprove     String   @map("how_to_improve") @db.Text
  targetTab        String?  @map("target_tab") // backlinks | referring_domains | anchors | top_pages | new_lost
  filterParamsJson Json?    @map("filter_params_json")
  evidenceJson     Json?    @map("evidence_json")
  actionsJson      Json?    @map("actions_json")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  audit BacklinkAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, ruleKey])
  @@index([auditId])
  @@index([severity])
  @@index([priorityScore])
  @@map("backlink_recommendations")
}

// ----------------------------------------------------------------
// SCHEMA MARKUP & STRUCTURED DATA SUITE
// ----------------------------------------------------------------

model SchemaAudit {
  id                String   @id @default(uuid()) @db.Uuid
  websiteId         String?  @map("website_id") @db.Uuid
  url               String
  domain            String
  overallScore      Int      @default(0) @map("overall_score") // 0-100
  totalSchemas      Int      @default(0) @map("total_schemas")
  validCount        Int      @default(0) @map("valid_count")
  errorCount        Int      @default(0) @map("error_count")
  warningCount      Int      @default(0) @map("warning_count")
  opportunityCount  Int      @default(0) @map("opportunity_count")
  detectedTypes     String[] @map("detected_types")
  status            String   @default("completed") @map("status") // completed | failed
  rawExtractionJson Json?    @map("raw_extraction_json")
  summaryJson       Json?    @map("summary_json")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  website           Website?      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  items             SchemaItem[]
  issues            SchemaIssue[]

  @@index([websiteId])
  @@index([url])
  @@index([domain])
  @@index([createdAt])
  @@map("schema_audits")
}

model SchemaItem {
  id          String      @id @default(uuid()) @db.Uuid
  auditId     String      @map("audit_id") @db.Uuid
  schemaType  String      @map("schema_type") // e.g. "Product", "FAQPage"
  format      String      @default("JSON-LD") @map("format") // "JSON-LD" | "Microdata" | "RDFa"
  isValid     Boolean     @default(true) @map("is_valid")
  hasErrors   Boolean     @default(false) @map("has_errors")
  hasWarnings Boolean     @default(false) @map("has_warnings")
  rawJson     Json        @map("raw_json")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  audit       SchemaAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  issues      SchemaIssue[]

  @@index([auditId])
  @@index([schemaType])
  @@map("schema_items")
}

model SchemaIssue {
  id             String      @id @default(uuid()) @db.Uuid
  auditId        String      @map("audit_id") @db.Uuid
  schemaItemId   String?     @map("schema_item_id") @db.Uuid
  schemaType     String      @map("schema_type")
  field          String?     // e.g. "offers.price", "author.name"
  issueType      String      @map("issue_type") // MISSING_REQUIRED | MISSING_RECOMMENDED | SYNTAX_ERROR | INVALID_FORMAT | PROTOCOL_HTTP
  severity       String      @map("severity") // Error | Warning | Opportunity
  message        String      @db.Text
  recommendation String      @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  audit          SchemaAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  schemaItem     SchemaItem? @relation(fields: [schemaItemId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([severity])
  @@map("schema_issues")
}

// ----------------------------------------------------------------
// KEYWORD RESEARCH & SERP INTELLIGENCE SUITE
// ----------------------------------------------------------------

model KeywordSearch {
  id              String        @id @default(uuid()) @db.Uuid
  websiteId       String?       @map("website_id") @db.Uuid
  query           String
  location        String        @default("United States")
  language        String        @default("en")
  totalResults    Int           @default(0) @map("total_results")
  avgSearchVolume Int           @default(0) @map("avg_search_volume")
  avgDifficulty   Int           @default(0) @map("avg_difficulty")
  resultsJson     Json?         @map("results_json")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  website         Website?      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  ideas           KeywordIdea[]

  @@index([query])
  @@index([websiteId])
  @@index([createdAt])
  @@map("keyword_searches")
}

model KeywordIdea {
  id           String        @id @default(uuid()) @db.Uuid
  searchId     String        @map("search_id") @db.Uuid
  keyword      String
  searchVolume Int           @default(0) @map("search_volume")
  cpc          Float         @default(0)
  ppc          Int           @default(0)
  difficulty   Int           @default(0) // KD 0-100
  intent       String        @default("Informational") // Informational | Commercial | Transactional | Navigational
  trendJson    Json?         @map("trend_json") // 12-month volume history array
  category     String        @default("related") // related | question | autocomplete
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  search       KeywordSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId])
  @@index([keyword])
  @@index([difficulty])
  @@index([searchVolume])
  @@map("keyword_ideas")
}

model TrackedKeyword {
  id               String   @id @default(uuid()) @db.Uuid
  websiteId        String   @map("website_id") @db.Uuid
  keyword          String
  targetUrl        String?  @map("target_url")
  searchVolume     Int      @default(0) @map("search_volume")
  cpc              Float    @default(0)
  difficulty       Int      @default(0)
  currentPosition  Int?     @map("current_position") // 1-100
  previousPosition Int?     @map("previous_position")
  bestPosition     Int?     @map("best_position")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, keyword])
  @@index([websiteId])
  @@map("tracked_keywords")
}

model Article {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique
  title           String
  description     String?   @db.Text
  content         String    @db.Text
  coverImage      String?   @map("cover_image")
  authorName      String    @default("Editorial Team") @map("author_name")
  authorTitle     String?   @map("author_title")
  authorAvatar    String?   @map("author_avatar")
  category        String    @default("Technical SEO")
  tags            String[]  @default([])
  readTimeMinutes Int       @default(5) @map("read_time_minutes")
  isPublished     Boolean   @default(false) @map("is_published")
  isFeatured      Boolean   @default(false) @map("is_featured")
  viewCount       Int       @default(0) @map("view_count")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isPublished, publishedAt])
  @@index([category])
  @@index([slug])
  @@map("articles")
}
