  updatedAt                  DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  features                   PlanFeature[]
  publicFeatures             PlanPublicFeature[]
  prices                     PlanPrice[]
  entitlements               PlanEntitlement[]
  subscriptions              Subscription[]

  @@map("plans")
}

model PlanPrice {
