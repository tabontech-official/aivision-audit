  stripeChargeId        String?       @map("stripe_charge_id")
  amountCents           Int           @map("amount_cents")
  currency              String        @default("usd")
  status                PaymentStatus
  failureReason         String?       @map("failure_reason")
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoices     Invoice[]

  @@index([userId])
  @@map("payments")
}

model Invoice {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  paymentId        String?   @map("payment_id") @db.Uuid
  stripeInvoiceId  String?   @unique @map("stripe_invoice_id")
  invoiceNumber    String?   @map("invoice_number")
  amountCents      Int       @map("amount_cents")
  currency         String    @default("usd")
  pdfUrl           String?   @map("pdf_url") // Stripe-hosted invoice PDF
  hostedInvoiceUrl String?   @map("hosted_invoice_url")
  issuedAt         DateTime? @map("issued_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("invoices")
}

// Stripe webhook idempotency ledger
model StripeWebhookEvent {
  id            String    @id @default(uuid()) @db.Uuid
  stripeEventId String    @unique @map("stripe_event_id")
  type          String
  processedAt   DateTime? @map("processed_at") @db.Timestamptz
  payload       Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("stripe_webhook_events")
}

// ----------------------------------------------------------------
// LEADS — the primary business goal
// ----------------------------------------------------------------

// Captured on the landing form BEFORE the audit runs: a visitor who audits,
// reads the teaser and leaves still gave us a URL and an email. One row per
// email+domain pair; repeat audits update rather than duplicate.
model Lead {
  id         String @id @default(uuid()) @db.Uuid
  email      String
  websiteUrl String @map("website_url") // normalized
  domain     String // for grouping and dedupe

  // GDPR/UK-PECR: consent defaults unticked, stored with proof. The IP is
  // hashed — proof of consent without retaining the address itself.
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  consentAt        DateTime? @map("consent_at") @db.Timestamptz
  consentIpHash    String?   @map("consent_ip_hash") // sha256(ip)
  source           String? // landing | pricing | blog | partner

  // Shopify pivot: which platforms show up is market data.
  platform       String? // SHOPIFY | HYDROGEN | WORDPRESS | … | UNKNOWN
  themeName      String? @map("theme_name")
  appCount       Int?    @map("app_count")
  plusLikelihood String? @map("plus_likelihood") // unknown | possible

  anonymousSessionId String?   @map("anonymous_session_id") @db.Uuid
  firstReportId      String?   @map("first_report_id") @db.Uuid
  convertedUserId    String?   @map("converted_user_id") @db.Uuid
  convertedAt        DateTime? @map("converted_at") @db.Timestamptz

  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([email, domain])
  @@index([email])
  @@index([domain])
  @@index([convertedUserId])
  @@index([platform])
  @@map("leads")
}

// ----------------------------------------------------------------
// THE FIX LOOP (Phase 2)
// ----------------------------------------------------------------

model Finding {
  id        String  @id @default(uuid()) @db.Uuid
  websiteId String  @map("website_id") @db.Uuid
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  identityHash String @map("identity_hash") // sha256(fieldKey + ':' + normalizedPageUrl)
  fieldKey     String @map("field_key")
  pageUrl      String @map("page_url")

  // Denormalized for display and filtering — REFRESHED on every reconciliation.
  sectionSlug String   @map("section_slug")
  sectionName String   @map("section_name")
  checkName   String   @map("check_name")
  severity    Severity
  pillar      ReportPillar @default(FOUNDATIONS)

  state    FindingState @default(OPEN)
  userNote String?      @map("user_note") @db.Text

  firstSeenAt  DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz // set entering VERIFIED_FIXED, cleared on exit
  staleSince   DateTime? @map("stale_since") @db.Timestamptz // audit produced no result for this identity
  lastReportId String?   @map("last_report_id") @db.Uuid

  events FindingEvent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([websiteId, identityHash])
  @@index([websiteId, state])
  @@index([websiteId, severity])
  @@index([websiteId, staleSince])
  @@map("findings")
}

model FindingEvent {
  id        String  @id @default(uuid()) @db.Uuid
  findingId String  @map("finding_id") @db.Uuid
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  // Deleting a report must never destroy finding history — SetNull, not Cascade.
  reportId String? @map("report_id") @db.Uuid
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  checkStatus CheckStatus?  @map("check_status") // what the engine observed this run
  stateBefore FindingState? @map("state_before") // null = this event created the finding
  stateAfter  FindingState  @map("state_after")
  actor       FindingActor
  userId      String?       @map("user_id") @db.Uuid
  note        String?       @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([findingId, createdAt])
  @@index([reportId])
  @@map("finding_events")
}

// Lightweight funnel counters (Part D) — append-only, so the progressive
// lead-capture decision can be evaluated rather than argued about. The number
// that matters: emails captured per 100 audits started.
model FunnelEvent {
  id        String   @id @default(uuid()) @db.Uuid
  event     String // audit_started | email_captured_progress | email_captured_signup | audit_completed | teaser_viewed | signup_completed
  reportId  String?  @map("report_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([event, createdAt])
  @@map("funnel_events")
}

// ----------------------------------------------------------------
// SYSTEM
// ----------------------------------------------------------------

// Key-value settings. Typed access layer validates each key with Zod.
// `isSecret` values are AES-256-GCM encrypted (SETTINGS_ENCRYPTION_KEY) via
// src/lib/security/secrets.ts, masked in all API responses. Migrate legacy
// plaintext rows with scripts/encrypt-secret-settings.ts.
// Seeded keys: product_name, support_email, free_audit_limit,
// premium_audit_limit, anonymous_report_expiration_days, score_ranges,
// pagespeed_api_key (secret), maintenance_mode, terms_url, privacy_url,
// cookie_policy_url, anonymous_audits_per_hour_ip
model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json?
  isSecret    Boolean  @default(false) @map("is_secret")
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model BrandingSetting {
  id           String   @id @default(uuid()) @db.Uuid
  productName  String   @default("AuditFlow") @map("product_name")
  logoUrl      String?  @map("logo_url")
  logoDarkUrl  String?  @map("logo_dark_url")
  faviconUrl   String?  @map("favicon_url")
  primaryColor String   @default("#4F46E5") @map("primary_color") // indigo-600
  accentColor  String   @default("#7C3AED") @map("accent_color") // premium purple
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy User? @relation("BrandingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("branding_settings")
}

// Editable transactional email templates. Variables use the same {{placeholder}}
// whitelist convention as suggestions ({{name}}, {{verifyUrl}}, {{resetUrl}}, …).
model EmailTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  key                String   @unique // verify_email | reset_password | report_ready | welcome | payment_failed
  name               String
  subject            String
  htmlBody           String   @map("html_body")
  textBody           String?  @map("text_body")
  availableVariables Json     @default("[]") @map("available_variables") // string[]
  isEnabled          Boolean  @default(true) @map("is_enabled")
  updatedById        String?  @map("updated_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy User? @relation("EmailTplUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("email_templates")
}

// Every admin mutation: who, what, before/after
model AdminActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. "section.update", "user.plan_change"
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("LogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

// External API consumption tracking (PSI, Browserless, Resend, Stripe)
model ApiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  provider     String // pagespeed | browserless | resend | stripe
  endpoint     String?
  userId       String?  @map("user_id") @db.Uuid
  reportId     String?  @map("report_id") @db.Uuid
  statusCode   Int?     @map("status_code")
  durationMs   Int?     @map("duration_ms")
  success      Boolean  @default(true)
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([userId])
  @@map("api_usage")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?          @map("link_url")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

// Complete App Execution Logs — capturing pipeline stages, stuck audits, errors & stack traces
model SystemExecutionLog {
  id           String   @id @default(uuid()) @db.Uuid
  level        LogLevel @default(INFO)
  category     String   // e.g. "AUDIT_PIPELINE", "FETCH_HTML", "PLAYWRIGHT_RENDER", "PAGESPEED_API", "SYSTEM_ERROR"
  message      String
  reportId     String?  @map("report_id") @db.Uuid
  websiteUrl   String?  @map("website_url")
  stage        String?  // AuditStage string representation
  durationMs   Int?     @map("duration_ms")
  meta         Json?    // Context payload, HTTP headers, request params
  stackTrace   String?  @map("stack_trace")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([level])
  @@index([category])
  @@index([reportId])
  @@index([createdAt])
  @@map("system_execution_logs")
}

