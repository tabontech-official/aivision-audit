  pageAuditLimit             Int                 @default(100) @map("page_audit_limit") // Total page coverage limit (10, 100, 1000, 3000, etc.)
  initialSampleSize          Int                 @default(30) @map("initial_sample_size") // Initial sample size per audit (10, 30, 50, 100, etc.)
