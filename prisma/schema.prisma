  auditHistoryRetentionDays  Int                 @default(30) @map("audit_history_retention_days") // Retention in days (Free: 7, Starter: 30, Pro: 90, Agency: 365, -1 = unlimited)
  scheduledAuditFrequency    String              @default("MONTHLY") @map("scheduled_audit_frequency") // "DISABLED", "MONTHLY", "BIWEEKLY", "WEEKLY"
  scheduledAuditsEnabled     Boolean             @default(true) @map("scheduled_audits_enabled")
  reAuditEnabled             Boolean             @default(true) @map("re_audit_enabled")
  auditComparisonEnabled     Boolean             @default(true) @map("audit_comparison_enabled")
  auditLimitType             String              @default("MONTHLY") @map("audit_limit_type") // MONTHLY, BILLING_CYCLE, LIFETIME, UNLIMITED
  auditResetPeriod           String              @default("MONTHLY") @map("audit_reset_period") // MONTHLY, BILLING_CYCLE, NEVER
  concurrentAuditsLimit      Int                 @default(1) @map("concurrent_audits_limit")
  autoRefundOnFailure        Boolean             @default(true) @map("auto_refund_on_failure")
