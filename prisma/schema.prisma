// ==============================================================
// AuditFlow — Prisma schema (source of truth)
// Database: Neon PostgreSQL
// ==============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ----------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------

enum UserRole {
  MASTER_ADMIN
  ADMIN
  USER
}

enum UserPlan {
  FREE
  PREMIUM
}

enum PlanAccess {
  FREE
  PREMIUM
  HIDDEN
  BOTH
}

enum ReportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

// Why an audit failed. Drives allowance refunds: a SYSTEM failure is our
// fault and must not consume the user's monthly credit, while a bad URL or an
// unreachable target site is a real attempt and still counts.
enum FailureCategory {
  SYSTEM // dispatch failure, reaped orphan, transaction error, uncaught crash
  USER_INPUT // invalid or unauditable URL
  TARGET_SITE // the audited site could not be fetched or rendered
}

// Which page type a check inspects (multi-page sampling). HOME is the audited
// URL itself and always exists; the rest are sampled from the site's sitemap
// when discovery succeeds. A check whose page type was not sampled resolves
// NOT_APPLICABLE — never a false failure.
enum ReportPageType {
  HOME
  PRODUCT
  COLLECTION
  BLOG
}

// Report pillars (Part F) — the customer-facing grouping above sections.
// Order here is display order.
enum ReportPillar {
  FOUNDATIONS
  SPEED_VITALS
  ONPAGE_CONTENT
  AI_ANSWER_ENGINES
  TRUST_COMPLIANCE
  CONVERSION_UX
}

// The Fix Loop (Phase 2). A Finding lives on the WEBSITE, not the report:
// reports are observations of ongoing state, and this is what makes audit N
// aware that audit N-1 existed.
enum FindingState {
  OPEN // detected, untouched
  ACKNOWLEDGED // user confirms it's real
  IN_PROGRESS // user is working on it
  MARKED_FIXED // user claims fixed — awaiting verification
  VERIFIED_FIXED // engine confirmed it now passes
  STILL_FAILING // user said fixed; engine disagrees
  REGRESSED // was verified fixed, now failing again
  WONT_FIX // accepted risk — excluded from scoring
  FALSE_POSITIVE // user disputes the check — excluded from scoring
}

enum FindingActor {
  ENGINE
  USER
}

enum AuditSchedule {
  NONE
  WEEKLY
  MONTHLY
}

enum AuditStage {
  CONNECTING
  FETCHING_HTML
  RENDERING
  CHECKING_SEO
  CHECKING_SPEED
  INSPECTING_METADATA
  REVIEWING_ACCESSIBILITY
  ANALYZING_MOBILE
  CHECKING_CONVERSION
  PREPARING_RECOMMENDATIONS
  GENERATING_REPORT
}

enum CheckStatus {
  PASS
  FAIL
  WARNING
  INFO
  NOT_APPLICABLE
  ERROR
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

enum InspectionType {
  ELEMENT_EXISTS
  ELEMENT_NOT_EXISTS
  ATTRIBUTE_EXISTS
  ATTRIBUTE_EQUALS
  ATTRIBUTE_CONTAINS
  TEXT_EXISTS
  TEXT_CONTAINS
  ELEMENT_COUNT
  TEXT_LENGTH
  HTTP_STATUS
  REDIRECT_CHECK
  SSL_CHECK
  RESPONSE_HEADER
  BROKEN_LINKS
  IMAGE_ALT_TEXT
  HTML_VALIDATION
  META_TAG
  HEADING_HIERARCHY
  CANONICAL_TAG
  ROBOTS_META
  SITEMAP_CHECK
  ROBOTS_TXT_CHECK
  STRUCTURED_DATA
  SCHEMA_TYPE
  MOBILE_VIEWPORT
  FORM_FIELD
  CTA_CHECK
  PSI_METRIC
  LIGHTHOUSE_SCORE
  API_CHECK
  RULES_EVALUATOR // sandboxed JsonLogic — safe replacement for "custom JavaScript"
  REGEX_EVALUATOR
  BOOLEAN_CHECK
  NUMERIC_COMPARISON
  STRING_COMPARISON
}

enum CriteriaOperator {
  EXISTS
  NOT_EXISTS
  EQUALS
  NOT_EQUALS
  CONTAINS
  NOT_CONTAINS
  STARTS_WITH
  ENDS_WITH
  GREATER_THAN
  LESS_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN_OR_EQUAL
  BETWEEN
  MATCHES_REGEX
  IS_TRUE
  IS_FALSE
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum PaymentStatus {
  SUCCEEDED
  PENDING
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PsiStrategy {
  MOBILE
  DESKTOP
}

enum NotificationType {
  REPORT_READY
  REPORT_FAILED
  PLAN_UPGRADED
  PLAN_DOWNGRADED
  PAYMENT_FAILED
  SYSTEM
}

// ----------------------------------------------------------------
// AUTH & IDENTITY
// ----------------------------------------------------------------

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String?   @map("password_hash") // null for future OAuth-only users
  name                String?
  image               String?
  role                UserRole  @default(USER)
  plan                UserPlan  @default(FREE)
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  // Copied from the Lead on signup; marketing sends must check this, not the Lead.
  marketingConsent    Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt  DateTime? @map("marketing_consent_at") @db.Timestamptz
  // Delta/result audit emails — a separate switch from marketing consent:
  // these are transactional, but the user may still opt out of them.
  auditEmailsEnabled  Boolean   @default(true) @map("audit_emails_enabled")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  accounts            Account[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  claimedAnonSessions AnonymousSession[]   @relation("ClaimedAnonSessions")
  ownedOrganizations  Organization[]       @relation("OrgOwner")
  organizationMembers OrganizationMember[]
  websites            Website[]
  reports             Report[]
  subscriptions       Subscription[]
  payments            Payment[]
  invoices            Invoice[]
  notifications       Notification[]
  createdTemplates    ReportTemplate[]     @relation("TemplateCreator")
  publishedVersions   TemplateVersion[]    @relation("VersionPublisher")
  activityLogs        AdminActivityLog[]   @relation("LogActor")
  updatedSettings     SystemSetting[]      @relation("SettingUpdater")
  updatedBranding     BrandingSetting[]    @relation("BrandingUpdater")
  updatedEmailTpls    EmailTemplate[]      @relation("EmailTplUpdater")
  apiUsage            ApiUsage[]
  usageEvents         UsageEvent[]
  bonusCredits        BonusCredit[]
  billingAuditLogs    BillingAuditLog[]    @relation("BillingActor")
  generatedSchemas    GeneratedSchema[]

  @@index([role])
  @@index([plan])
  @@map("users")
}

// Auth.js OAuth accounts (future-ready; credentials flow doesn't use it)
model Account {
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

// Session revocation registry. JWT strategy is primary; every issued JWT carries
// a sessionId that must exist & be unrevoked here for sensitive operations.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  rememberMe Boolean   @default(false) @map("remember_me")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") // sha256 of the emailed token
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Anonymous audit sessions — cookie token is hashed, never stored raw
model AnonymousSession {
  id              String    @id @default(uuid()) @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  claimedByUserId String?   @map("claimed_by_user_id") @db.Uuid
  claimedAt       DateTime? @map("claimed_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  claimedBy User?    @relation("ClaimedAnonSessions", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  reports   Report[]

  @@index([expiresAt])
  @@map("anonymous_sessions")
}

// Future-ready multi-seat support (not surfaced in v1 UI)
model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  ownerId   String    @map("owner_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  owner   User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("member") // owner | admin | member
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@map("organization_members")
}

// ----------------------------------------------------------------
// DYNAMIC REPORT BUILDER
// Template → Version (immutable once published) → Sections → Fields
//   → Criteria → Suggestions
// ----------------------------------------------------------------

model ReportTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isDefault   Boolean   @default(false) @map("is_default")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy User?             @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions  TemplateVersion[]

  @@map("report_templates")
}

// Admin edits the latest DRAFT version; Publish freezes it and clones a new
// DRAFT. Reports pin the version they ran against, so history never mutates.
model TemplateVersion {
  id            String         @id @default(uuid()) @db.Uuid
  templateId    String         @map("template_id") @db.Uuid
  versionNumber Int            @map("version_number")
  status        TemplateStatus @default(DRAFT)
  publishedAt   DateTime?      @map("published_at") @db.Timestamptz
  publishedById String?        @map("published_by_id") @db.Uuid
  changelog     String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  template    ReportTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  publishedBy User?           @relation("VersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  sections    ReportSection[]
  reports     Report[]

  @@unique([templateId, versionNumber])
  @@index([status])
  @@map("template_versions")
}

model ReportSection {
  id                  String     @id @default(uuid()) @db.Uuid
  templateVersionId   String     @map("template_version_id") @db.Uuid
  name                String
  slug                String
  shortDescription    String?    @map("short_description")
  detailedDescription String?    @map("detailed_description")
  icon                String? // lucide icon name, validated against whitelist
  displayOrder        Int        @default(0) @map("display_order")
  isEnabled           Boolean    @default(true) @map("is_enabled")
  defaultExpanded     Boolean    @default(true) @map("default_expanded")
  weight              Float      @default(1) // contribution to overall score
  contributesToScore  Boolean    @default(true) @map("contributes_to_score")
  planAccess          PlanAccess @default(BOTH) @map("plan_access")
  visibleInReport     Boolean    @default(true) @map("visible_in_report")
  accentColor         String?    @map("accent_color") // hex, validated
  // Customer-facing grouping above sections (Part F). Migration maps existing
  // sections explicitly by slug; only genuinely new sections take the default.
  pillar              ReportPillar @default(FOUNDATIONS)
  isSystem            Boolean    @default(false) @map("is_system") // e.g. Page Speed — undeletable
  // JsonLogic gate (same sandboxed evaluator as RULES_EVALUATOR) over the
  // extracted snapshot. Falsy → every check in the section is NOT_APPLICABLE
  // (excluded from scoring, recorded in scoreBasis). Absent → always applies.
  appliesWhen         String?    @map("applies_when")
  adminNotes          String?    @map("admin_notes")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz

  templateVersion TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  fields          AuditField[]
  sectionResults  ReportSectionResult[]

  @@unique([templateVersionId, slug])
  @@index([templateVersionId, displayOrder])
  @@map("report_sections")
}

model AuditField {
  id             String     @id @default(uuid()) @db.Uuid
  sectionId      String     @map("section_id") @db.Uuid
  name           String
  fieldKey       String     @map("field_key") // stable machine key, e.g. "seo.title_tag"
  description    String?
  displayOrder   Int        @default(0) @map("display_order")
  isEnabled      Boolean    @default(true) @map("is_enabled")
  planAccess     PlanAccess @default(BOTH) @map("plan_access")
  severity       Severity   @default(MEDIUM)
  category       String?
  score          Float      @default(1) // max points for this check
  weight         Float      @default(1)
  passLabel      String     @default("Yes") @map("pass_label")
  failLabel      String     @default("No") @map("fail_label")
  warningLabel   String     @default("Partial") @map("warning_label")
  helpArticleUrl String?    @map("help_article_url")
  // Per-check JsonLogic gate; falsy → NOT_APPLICABLE. Errors fail OPEN (the
  // check runs) — a misconfigured gate must not silently delete checks.
  appliesWhen    String?    @map("applies_when")
  // Which sampled page this check inspects. HOME (default) is the audited URL.
  pageType       ReportPageType @default(HOME) @map("page_type")
  adminNotes     String?    @map("admin_notes")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz

  section     ReportSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  criteria    AuditCriteria?
  suggestions AuditSuggestion[]
  results     AuditResult[]

  @@unique([sectionId, fieldKey])
  @@index([sectionId, displayOrder])
  @@map("audit_fields")
}

// One criteria row per field. `config` is a Zod-validated, inspection-type-
// specific JSON payload (selector, attribute, header name, PSI metric key,
// JsonLogic rules for RULES_EVALUATOR, …). No executable code is ever stored.
model AuditCriteria {
  id            String           @id @default(uuid()) @db.Uuid
  fieldId       String           @unique @map("field_id") @db.Uuid
  inspectionType InspectionType  @map("inspection_type")
  dataSource    String           @default("HTML") @map("data_source") // HTML | RENDERED_DOM | HEADERS | PSI | ROBOTS | SITEMAP | NETWORK
  selector      String? // CSS selector or extraction rule
  attributeName String?          @map("attribute_name")
  operator      CriteriaOperator
  expectedValue String?          @map("expected_value")
  minValue      Float?           @map("min_value")
  maxValue      Float?           @map("max_value")
  regexPattern  String?          @map("regex_pattern") // validated + complexity-capped (ReDoS guard)
  caseSensitive Boolean          @default(false) @map("case_sensitive")

  // Optional secondary band: if pass fails but this passes → WARNING not FAIL
  warnOperator      CriteriaOperator? @map("warn_operator")
  warnExpectedValue String?           @map("warn_expected_value")
  warnMinValue      Float?            @map("warn_min_value")
  warnMaxValue      Float?            @map("warn_max_value")

  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  field AuditField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@map("audit_criteria")
}

// Messages + suggestions per outcome status. One row per (field, status).
// Templates support {{domain}} {{actualValue}} {{expectedValue}} {{count}}
// {{minimum}} {{maximum}} {{pageTitle}} {{sectionName}} — interpolated
// server-side with a strict whitelist, output escaped.
model AuditSuggestion {
  id         String      @id @default(uuid()) @db.Uuid
  fieldId    String      @map("field_id") @db.Uuid
  forStatus  CheckStatus @map("for_status")
  message    String // e.g. "Your page is missing a title tag."
  suggestion String? // actionable recommendation
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  field AuditField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, forStatus])
  @@map("audit_suggestions")
}

// ----------------------------------------------------------------
// WEBSITES, REPORTS, RESULTS
// ----------------------------------------------------------------

model Website {
  id             String    @id @default(uuid()) @db.Uuid
  url            String // normalized origin + path
  domain         String
  faviconUrl     String?   @map("favicon_url")
  userId         String?   @map("user_id") @db.Uuid // null for anonymous, claimed on signup
  firstAuditedAt DateTime? @map("first_audited_at") @db.Timestamptz
  lastAuditedAt  DateTime? @map("last_audited_at") @db.Timestamptz
  // Scheduled re-audits (§2.9): FREE plans may schedule MONTHLY at most,
  // PREMIUM may schedule WEEKLY. Enforced at save and re-checked by the cron.
  auditSchedule  AuditSchedule @default(NONE) @map("audit_schedule")
  // "Skip and notify ONCE" when the allowance is exhausted — this remembers
  // that the notice was sent so a full month never produces a notice storm.
  scheduleSkipNotifiedAt DateTime? @map("schedule_skip_notified_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports  Report[]
  findings Finding[]
  backlinkAudits BacklinkAudit[]
  schemaAudits   SchemaAudit[]
  keywordSearches KeywordSearch[]
  trackedKeywords TrackedKeyword[]
  generatedSchemas GeneratedSchema[]

  @@unique([userId, url])
  @@index([userId])
  @@index([domain])
  @@map("websites")
}

model Report {
  id                 String        @id @default(uuid()) @db.Uuid
  publicId           String        @unique @map("public_id") // unguessable URL id (nanoid 21)
  websiteId          String        @map("website_id") @db.Uuid
  userId             String?       @map("user_id") @db.Uuid
  anonymousSessionId String?       @map("anonymous_session_id") @db.Uuid
  templateVersionId  String        @map("template_version_id") @db.Uuid
  status             ReportStatus  @default(QUEUED)
  currentStage       AuditStage?   @map("current_stage")
  progressPercent    Int           @default(0) @map("progress_percent")
  planAtGeneration   UserPlan      @default(FREE) @map("plan_at_generation")
  overallScore       Float?        @map("overall_score")
  grade              String? // "Excellent" | "Good" | "Needs Improvement" | "Poor" (from settings)
  mobileScore        Float?        @map("mobile_score")
  desktopScore       Float?        @map("desktop_score")
  passedCount        Int           @default(0) @map("passed_count")
  failedCount        Int           @default(0) @map("failed_count")
  warningCount       Int           @default(0) @map("warning_count")
  criticalIssueCount Int           @default(0) @map("critical_issue_count")
  screenshotUrl      String?       @map("screenshot_url")
  errorMessage       String?       @map("error_message") // safe, user-facing failure summary
  failureCategory    FailureCategory? @map("failure_category") // who is at fault — drives allowance refunds
  retryCount         Int           @default(0) @map("retry_count") // watchdog auto-retries once
  // Fix Loop (Phase 2). previousReportId is resolved at RECONCILIATION time —
  // most recent COMPLETED/PARTIAL reconciled report for the same website —
  // so out-of-order completion cannot produce a wrong chain.
  previousReportId      String?   @map("previous_report_id") @db.Uuid
  scoreDelta            Float?    @map("score_delta")
  findingsReconciledAt  DateTime? @map("findings_reconciled_at") @db.Timestamptz
  // Audit Coverage & Scope tracking
  totalDetectedUrls     Int?          @default(0) @map("total_detected_urls")
  coverageLimit         Int?          @default(100) @map("coverage_limit")
  coverageUsed          Int?          @default(0) @map("coverage_used")
  coverageRemaining     Int?          @default(0) @map("coverage_remaining")
  initialSampleSize     Int?          @default(30) @map("initial_sample_size")
  coverageCompleted     Boolean       @default(false) @map("coverage_completed")
  currentPlanKey        String?       @map("current_plan_key")
  lastProcessedPosition Int?          @default(0) @map("last_processed_position")
  urlGroups             Json?         @map("url_groups")
  discoveredUrlsList    Json?         @map("discovered_urls_list")

  startedAt          DateTime?     @map("started_at") @db.Timestamptz
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz
  expiresAt          DateTime?     @map("expires_at") @db.Timestamptz // anonymous reports expire
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz

  website          Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousSession AnonymousSession?     @relation(fields: [anonymousSessionId], references: [id], onDelete: SetNull)
  templateVersion  TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  sectionResults   ReportSectionResult[]
  auditResults     AuditResult[]
  rawData          WebsiteRawData?
  pageSpeedResults PageSpeedResult[]
  snapshot         ReportSnapshot?
  findingEvents    FindingEvent[]
  sampledPages     SampledPage[]

  @@index([userId, createdAt])
  @@index([websiteId])
  @@index([anonymousSessionId])
  @@index([status])
  @@index([expiresAt])
  @@map("reports")
}

model ReportSectionResult {
  id           String      @id @default(uuid()) @db.Uuid
  reportId     String      @map("report_id") @db.Uuid
  sectionId    String      @map("section_id") @db.Uuid
  score        Float?
  maxScore     Float?      @map("max_score")
  status       CheckStatus @default(INFO) // rollup
  summary      String?
  passedCount  Int         @default(0) @map("passed_count")
  failedCount  Int         @default(0) @map("failed_count")
  warningCount Int         @default(0) @map("warning_count")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  report  Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  section ReportSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  results AuditResult[]

  @@unique([reportId, sectionId])
  @@index([reportId])
  @@map("report_section_results")
}

model AuditResult {
  id                String      @id @default(uuid()) @db.Uuid
  reportId          String      @map("report_id") @db.Uuid
  sectionResultId   String      @map("section_result_id") @db.Uuid
  fieldId           String      @map("field_id") @db.Uuid
  status            CheckStatus
  severity          Severity
  actualValue       String?     @map("actual_value") // detected value, stringified
  expectedSummary   String?     @map("expected_summary") // human-readable expected condition
  evidence          Json? // snippets, counts, urls
  renderedMessage   String?     @map("rendered_message") // interpolated message
  renderedSuggestion String?    @map("rendered_suggestion") // interpolated suggestion
  score             Float       @default(0)
  maxScore          Float       @default(0) @map("max_score")
  isQuickWin        Boolean     @default(false) @map("is_quick_win")
  // Fix Loop: user-suppressed (WONT_FIX/FALSE_POSITIVE) — excluded from both
  // sides of the score exactly like NOT_APPLICABLE. `status` still records the
  // TRUE verdict; only its effect on the score is suppressed, never the
  // observation itself. findingId is a loose reference (no FK by design).
  suppressed        Boolean     @default(false)
  findingId         String?     @map("finding_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz

  report        Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sectionResult ReportSectionResult @relation(fields: [sectionResultId], references: [id], onDelete: Cascade)
  field         AuditField          @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([reportId, fieldId])
  @@index([reportId])
  @@index([sectionResultId])
  @@map("audit_results")
}

// Full extracted crawl snapshot — checks can be re-evaluated without re-crawling
model WebsiteRawData {
  id                  String   @id @default(uuid()) @db.Uuid
  reportId            String   @unique @map("report_id") @db.Uuid
  httpStatus          Int?     @map("http_status")
  finalUrl            String?  @map("final_url")
  redirectChain       Json?    @map("redirect_chain") // string[]
  responseHeaders     Json?    @map("response_headers") // Record<string,string>
  extracted           Json     @default("{}") // titles, metas, headings, links, images, OG, JSON-LD, forms, CTAs, trust signals, counts, ratios …
  html                String?  // page HTML (capped at 2MB) — enables selector checks on re-evaluation without re-crawling
  robotsTxt           String?  @map("robots_txt")
  sitemapInfo         Json?    @map("sitemap_info")
  brokenLinks         Json?    @map("broken_links") // Array<{url, status}>
  htmlSizeBytes       Int?     @map("html_size_bytes")
  fetchDurationMs     Int?     @map("fetch_duration_ms")
  renderedWithBrowser Boolean  @default(false) @map("rendered_with_browser")
  // Render-cost instrumentation (B.10): the pre-render decision with its
  // signals and reasons, whether a render ran, how long it took, and whether
  // the rendered DOM was actually richer. Queryable for the Pipeline Console
  // render-rate stats and for tuning RENDER_DECISION_THRESHOLD.
  renderMetrics       Json?    @map("render_metrics")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("website_raw_data")
}

// Additional pages sampled beyond the audited URL (multi-page sampling).
// WebsiteRawData stays 1:1 as the PRIMARY page — that contract is relied on
// throughout — and these are the extra page types discovered from the site's
// sitemap. One row per page type per report.
model SampledPage {
  id         String         @id @default(uuid()) @db.Uuid
  reportId   String         @map("report_id") @db.Uuid
  pageType   ReportPageType @map("page_type")
  url        String
  httpStatus Int?           @map("http_status")
  extracted  Json           @default("{}") // same ExtractedData shape as WebsiteRawData
  html       String? // capped; enables selector checks on re-evaluation
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, pageType])
  @@index([reportId])
  @@map("sampled_pages")
}

model PageSpeedResult {
  id                 String      @id @default(uuid()) @db.Uuid
  reportId           String      @map("report_id") @db.Uuid
  strategy           PsiStrategy
  performanceScore   Float?      @map("performance_score")
  accessibilityScore Float?      @map("accessibility_score")
  bestPracticesScore Float?      @map("best_practices_score")
  seoScore           Float?      @map("seo_score")
  fcpMs              Float?      @map("fcp_ms")
  lcpMs              Float?      @map("lcp_ms")
  tbtMs              Float?      @map("tbt_ms")
  cls                Float?
  speedIndexMs       Float?      @map("speed_index_ms")
  ttiMs              Float?      @map("tti_ms")
  inpMs              Float?      @map("inp_ms")
  serverResponseMs   Float?      @map("server_response_ms")
  opportunities      Json?
  diagnostics        Json?
  passedAudits       Json?       @map("passed_audits")
  rawResponse        Json?       @map("raw_response") // debug only, never sent to client
  fetchedAt          DateTime    @default(now()) @map("fetched_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, strategy])
  @@index([reportId])
  @@map("page_speed_results")
}

// Immutable JSON snapshot of the final rendered report payload (history/PDF)
model ReportSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @unique @map("report_id") @db.Uuid
  payload   Json
  // What fraction of the intended scoring model this score was actually
  // computed over, and which sections dropped out. A PARTIAL report's score is
  // not comparable to a COMPLETED one, and this is how the UI can say so.
  scoreBasis Json?   @map("score_basis")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_snapshots")
}

