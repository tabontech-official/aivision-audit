model Plan {
  id                         String              @id @default(uuid()) @db.Uuid
  key                        String              @unique
  name                       String
  description                String?
  priceMonthlyCents          Int                 @default(0) @map("price_monthly_cents")
  priceYearlyCents           Int                 @default(0) @map("price_yearly_cents")
  currency                   String              @default("usd")
  stripeProductId            String?             @map("stripe_product_id")
  stripePriceMonthlyId       String?             @map("stripe_price_monthly_id")
